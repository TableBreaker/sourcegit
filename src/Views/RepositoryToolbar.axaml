<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="using:SourceGit.Models"
             xmlns:vm="using:SourceGit.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SourceGit.Views.RepositoryToolbar"
             x:DataType="vm:Repository"
             Classes.labeled="{Binding Source={x:Static vm:Preferences.Instance}, Path=ShowToolbarLabels}">
  <Grid ColumnDefinitions="*,Auto,0,*">
    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="4,0,0,0">
      <Button Classes="icon_button"
              Click="ToggleToolbarLabels"
              ToolTip.Tip="Toggle button labels">
        <StackPanel Orientation="Vertical" Spacing="1" HorizontalAlignment="Center">
          <Path Width="14" Height="14" HorizontalAlignment="Center" Data="{StaticResource Icons.List}"/>
          <TextBlock Classes="toolbar_caption" Text="Labels"/>
        </StackPanel>
      </Button>

      <Button Classes="icon_button" Click="OpenWithExternalTools" ToolTip.Tip="{DynamicResource Text.Repository.OpenWithExternalTools}">
        <StackPanel Orientation="Vertical" Spacing="1">
          <Path Width="14" Height="14" HorizontalAlignment="Center" Data="{StaticResource Icons.OpenWith}"/>
          <TextBlock Classes="toolbar_caption" Text="Tools"/>
        </StackPanel>
      </Button>

      <Button Classes="icon_button" Click="OpenGitLogs" ToolTip.Tip="{DynamicResource Text.Repository.ViewLogs}">
        <StackPanel Orientation="Vertical" Spacing="1">
          <Path Width="14" Height="14" HorizontalAlignment="Center" Margin="0,1,0,0" Data="{StaticResource Icons.Logs}"/>
          <TextBlock Classes="toolbar_caption" Text="Logs"/>
        </StackPanel>
      </Button>

      <Button Classes="icon_button" Click="OpenStatistics" ToolTip.Tip="{DynamicResource Text.Repository.Statistics}">
        <StackPanel Orientation="Vertical" Spacing="1">
          <Path Width="13" Height="13" HorizontalAlignment="Center" Data="{StaticResource Icons.Statistics}"/>
          <TextBlock Classes="toolbar_caption" Text="Stats"/>
        </StackPanel>
      </Button>

      <Button Classes="icon_button" Click="OpenConfigure" ToolTip.Tip="{DynamicResource Text.Repository.Configure}">
        <StackPanel Orientation="Vertical" Spacing="1">
          <Path Width="14" Height="14" HorizontalAlignment="Center" Data="{StaticResource Icons.Settings}"/>
          <TextBlock Classes="toolbar_caption" Text="Config"/>
        </StackPanel>
      </Button>
    </StackPanel>

    <StackPanel Grid.Column="1" Orientation="Horizontal">
      <Button Classes="icon_button" Tapped="Fetch">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="{DynamicResource Text.Fetch}"/>
            <TextBlock Classes="small italic" Margin="0,4,0,0" Text="{DynamicResource Text.CtrlClickTip}" Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>

        <StackPanel Orientation="Vertical" Spacing="1">
          <Path Width="14" Height="14" HorizontalAlignment="Center" Data="{StaticResource Icons.Fetch}"/>
          <TextBlock Classes="toolbar_caption" Text="Fetch"/>
        </StackPanel>
      </Button>

      <Button Classes="icon_button" Margin="8,0,0,0" Tapped="Pull" IsVisible="{Binding !IsBare}" IsEnabled="{Binding !IsBare}">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="{DynamicResource Text.Pull}"/>
            <TextBlock Classes="small italic" Margin="0,4,0,0" Text="{DynamicResource Text.CtrlClickTip}" Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>

        <StackPanel Orientation="Vertical" Spacing="1">
          <Path Width="14" Height="14" HorizontalAlignment="Center" Data="{StaticResource Icons.Pull}"/>
          <TextBlock Classes="toolbar_caption" Text="Pull"/>
        </StackPanel>
      </Button>

      <Button Classes="icon_button" Margin="8,0,0,0" Tapped="Push">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="{DynamicResource Text.Push}"/>
            <TextBlock Classes="small italic" Margin="0,4,0,0" Text="{DynamicResource Text.CtrlClickTip}" Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>

        <StackPanel Orientation="Vertical" Spacing="1">
          <Path Width="14" Height="14" HorizontalAlignment="Center" Data="{StaticResource Icons.Push}"/>
          <TextBlock Classes="toolbar_caption" Text="Push"/>
        </StackPanel>
      </Button>

      <Button Classes="icon_button" Margin="8,0,0,0" Tapped="StashAll" IsVisible="{Binding !IsBare}">
        <ToolTip.Tip>
          <StackPanel Orientation="Vertical">
            <TextBlock Text="{DynamicResource Text.Stash}"/>
            <TextBlock Classes="small italic" Margin="0,4,0,0" Text="{DynamicResource Text.CtrlClickTip}" Foreground="{DynamicResource Brush.FG2}"/>
          </StackPanel>
        </ToolTip.Tip>

        <StackPanel Orientation="Vertical" Spacing="1">
          <Path Width="14" Height="14" HorizontalAlignment="Center" Data="{StaticResource Icons.Stashes.Add}"/>
          <TextBlock Classes="toolbar_caption" Text="Stash"/>
        </StackPanel>
      </Button>

      <Button Classes="icon_button" Margin="8,0,0,0" Command="{Binding ApplyPatch}" IsVisible="{Binding !IsBare}" ToolTip.Tip="{DynamicResource Text.Apply.Title}">
        <StackPanel Orientation="Vertical" Spacing="1">
          <Path Width="14" Height="14" HorizontalAlignment="Center" Data="{StaticResource Icons.ApplyPatch}"/>
          <TextBlock Classes="toolbar_caption" Text="Patch"/>
        </StackPanel>
      </Button>

      <Rectangle Width="1" Height="16"
                 Margin="8,0,0,0"
                 VerticalAlignment="Center"
                 Fill="{DynamicResource Brush.Border2}"/>

      <Button Classes="icon_button" Margin="10,0,0,0" Click="OpenGitFlowMenu" IsVisible="{Binding !IsBare}" ToolTip.Tip="{DynamicResource Text.GitFlow}">
        <StackPanel Orientation="Vertical" Spacing="1">
          <Path Width="14" Height="14" HorizontalAlignment="Center" Data="{StaticResource Icons.GitFlow}"/>
          <TextBlock Classes="toolbar_caption" Text="Flow"/>
        </StackPanel>
      </Button>

      <Button Classes="icon_button" Margin="8,0,0,0" Click="OpenGitLFSMenu" IsVisible="{Binding !IsBare}" ToolTip.Tip="{DynamicResource Text.GitLFS}">
        <StackPanel Orientation="Vertical" Spacing="1">
          <Path Width="14" Height="14" HorizontalAlignment="Center" Data="{StaticResource Icons.LFS}"/>
          <TextBlock Classes="toolbar_caption" Text="LFS"/>
        </StackPanel>
      </Button>

      <Button Classes="icon_button" Margin="8,0,0,0" Click="StartBisect" IsVisible="{Binding !IsBare}" ToolTip.Tip="{DynamicResource Text.Bisect}">
        <StackPanel Orientation="Vertical" Spacing="1">
          <Path Width="14" Height="14" HorizontalAlignment="Center" Data="{StaticResource Icons.Bisect}"/>
          <TextBlock Classes="toolbar_caption" Text="Bisect"/>
        </StackPanel>
      </Button>

      <Button Classes="icon_button" Margin="8,0,0,0" Click="OpenCustomActionMenu" ToolTip.Tip="{DynamicResource Text.Repository.CustomActions}">
        <StackPanel Orientation="Vertical" Spacing="1">
          <Path Width="14" Height="14" HorizontalAlignment="Center" Data="{StaticResource Icons.Action}"/>
          <TextBlock Classes="toolbar_caption" Text="Actions"/>
        </StackPanel>
      </Button>

      <Button Classes="icon_button" Margin="8,0,0,0" Click="Cleanup" ToolTip.Tip="{DynamicResource Text.Repository.Clean}">
        <StackPanel Orientation="Vertical" Spacing="1">
          <Path Width="14" Height="14" HorizontalAlignment="Center" Margin="0,1,0,0" Data="{StaticResource Icons.Clean}"/>
          <TextBlock Classes="toolbar_caption" Text="Clean"/>
        </StackPanel>
      </Button>
    </StackPanel>

    <StackPanel Grid.Column="2" Orientation="Horizontal">
      <Button Width="0" Height="0" Click="PushDirectlyByHotKey" IsVisible="False" HotKey="{OnPlatform Ctrl+Shift+Up, macOS=⌘+Shift+Up}"/>
      <Button Width="0" Height="0" Click="PullDirectlyByHotKey" IsVisible="False" IsEnabled="{Binding !IsBare}" HotKey="{OnPlatform Ctrl+Shift+Down, macOS=⌘+Shift+Down}"/>
      <Button Width="0" Height="0" Click="FetchDirectlyByHotKey" IsVisible="False" HotKey="{OnPlatform Ctrl+Down, macOS=⌘+Down}"/>
    </StackPanel>

    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0">
      <Path Width="13" Height="13" Fill="{DynamicResource Brush.FG1}" Data="{StaticResource Icons.Branch}"/>

      <ContentControl Margin="6,0,0,0">
        <ContentControl.Content>
          <Binding Path="CurrentBranch">
            <Binding.TargetNullValue>
              <TextBlock Text="--"/>
            </Binding.TargetNullValue>
          </Binding>
        </ContentControl.Content>

        <ContentControl.DataTemplates>
          <DataTemplate DataType="m:Branch">
            <Border Background="Transparent" ToolTip.Tip="{Binding FriendlyName}">
              <TextBlock Text="{Binding FriendlyName}" MaxWidth="250" TextTrimming="CharacterEllipsis"/>
            </Border>
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>

      <Button Classes="icon_button" Click="NavigateToHead" ToolTip.Tip="{DynamicResource Text.Repository.NavigateToCurrentHead}">
        <StackPanel Orientation="Vertical" Spacing="1">
          <Path Width="13" Height="13" HorizontalAlignment="Center" Margin="0,2,0,0" Data="{StaticResource Icons.Target}" Fill="{DynamicResource Brush.FG1}"/>
          <TextBlock Classes="toolbar_caption" Text="HEAD"/>
        </StackPanel>
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
